# VeriBrand AI Backend Configuration
PROJECT_NAME="VeriBrand AI"
ENVIRONMENT="development"
PORT=8081
HOST="0.0.0.0"

# Database Configuration
# MongoDB Atlas connection string (or local MongoDB).
# Password should be URL-encoded if it contains special characters.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/veribrand_ai?retryWrites=true&w=majority"
MONGODB_DB_NAME="veribrand_ai"
# Set ALLOW_MOCK_DB=true only for offline/local unit tests without network access
ALLOW_MOCK_DB=false

# Security & Authentication
# In production, set a secure random 256-bit key via environment variable (e.g. `openssl rand -hex 32`).
# Never commit production JWT secrets to source control.
JWT_SECRET="dev_insecure_jwt_secret_for_local_development_only_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Optional AI Engine Configuration (Deterministic verification works without any key)
LLM_PROVIDER="openai"
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"

# Operating Limits (as planned in Round 1 proposal)
MAX_PDF_SIZE_MB=10
MAX_PDF_PAGES=20
MAX_EXTRACTED_CHARS=10000
