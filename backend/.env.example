# VeriBrand AI Backend Configuration
PROJECT_NAME="VeriBrand AI"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Database Configuration
# Provide your MongoDB Atlas or local MongoDB URI.
# If not connected or in fallback mode, an in-memory/mongomock engine runs automatically.
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="veribrand_db"

# Security & Authentication
JWT_SECRET="veribrand_dev_secret_key_hackathon_round2_super_secure_2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Optional AI Engine Configuration (Deterministic verification works without any key)
LLM_PROVIDER="openai"
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"

# Operating Limits (as planned in Round 1 proposal)
MAX_PDF_SIZE_MB=10
MAX_PDF_PAGES=20
MAX_EXTRACTED_CHARS=10000
